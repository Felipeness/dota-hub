{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "pdf", "lado", "pergunta", "passos", "caminhos", "proxima", "origem", "fuga"],
    "properties": {
      "id": {"type": "string", "pattern": "^[A-Z]{1,2}-(R|D)-\\d{2}$"},
      "pdf": {"enum": ["03", "05", "06"]},
      "lado": {"enum": ["radiant", "dire"]},
      "heroi": {"type": ["string", "null"]},
      "origem": {"enum": ["recomendada", "real"]},
      "passos": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["n", "x", "y", "minuto", "via", "lugar"],
        "properties": {"x": {"type": "number", "minimum": -0.05, "maximum": 1.05}, "y": {"type": "number", "minimum": -0.05, "maximum": 1.05},
          "via": {"enum": [null, "tp", "portal", "salto"]}, "lugar": {"type": "integer", "minimum": 0}}}},
      "caminhos": {"type": "array", "items": {"type": "array", "not": {"minItems": 1, "maxItems": 1}}},
      "fuga": {"type": ["object", "null"], "required": ["de_passo", "x", "y", "rotulo", "via", "caminho"],
        "properties": {"via": {"enum": [null, "tp"]}, "caminho": {"type": "array", "minItems": 2}}},
      "proxima": {"type": "array", "items": {"type": "string"}}
    }
  }
}
