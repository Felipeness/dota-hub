{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array", "minItems": 127,
  "items": {"type": "object", "additionalProperties": false,
    "required": ["id", "nome", "hero_id", "nome_interno", "atributo", "posicoes", "pagina", "resumo"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "nome": {"type": "string", "minLength": 1},
      "nome_interno": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "hero_id": {"type": "integer"},
      "atributo": {"enum": ["str", "agi", "int", "all"]},
      "posicoes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 5}},
      "pagina": {"enum": ["guia", "ficha"]},
      "resumo": {"type": "string", "minLength": 1}
    }}
}
